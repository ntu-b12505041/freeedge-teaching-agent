PUBLIC_BASE_URL=https://your-public-domain.example
OUTPUT_DIR=output

# Best quality path: set this locally before running. Do not commit your key.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=cedar

# Default is free Edge voice. Set TTS_PROVIDER=openai only if you want paid OpenAI TTS.
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-GuyNeural
